tls:
  stores:
    default:
      defaultCertificate:
        certFile: /certs/wildcard.crt
        keyFile: /certs/wildcard.key

http:
  routers:
    keycloak-secure:
      rule: "Host(`{{ keycloak_host }}`)"
      entryPoints: [websecure]
      service: keycloak
      tls: {}
    keycloak:
      rule: "Host(`{{ keycloak_host }}`)"
      entryPoints: [web]
      middlewares: [redirect]
      service: keycloak
    pi-secure:
      rule: "Host(`{{ pi_host }}`)"
      entryPoints: [websecure]
      service: privacyidea
      tls: {}
    pi:
      rule: "Host(`{{ pi_host }}`)"
      entryPoints: [web]
      middlewares: [redirect]
      service: privacyidea
  middlewares:
    redirect:
      redirectScheme:
        scheme: https
  services:
    keycloak:
      loadBalancer:
        sticky:
          cookie:
            name: sticky_kc
            secure: true
        servers:
          - url: "http://keycloak:8080"
          - url: "http://{{ hostvars['node_2_secondary'].ansible_host }}:8080"
    privacyidea:
      loadBalancer:
        sticky:
          cookie:
            name: sticky_pi
            secure: true
        servers:
          - url: "http://privacyidea:8080"
          - url: "http://{{ hostvars['node_2_secondary'].ansible_host }}:8082"
