DOMAIN_NAME={{ domain_name }}
KEYCLOAK_HOST={{ keycloak_host }}
PI_HOST={{ pi_host }}

# Image tags
TRAEFIK_IMAGE={{ traefik_image }}
MARIADB_IMAGE={{ mariadb_image }}
PXC_IMAGE={{ pxc_image }}
KEYCLOAK_IMAGE={{ keycloak_image }}
PRIVACYIDEA_IMAGE={{ privacyidea_image }}

# Cluster Node Settings
NODE_ID={{ node_id }}
PXC_NODE_ADDRESS={{ pxc_node_address }}
PXC_CLIENT_HOST={{ pxc_client_host }}
KEYCLOAK_NODE_ADDRESS={{ keycloak_node_address | default(node_ip) }}
NODE1_IP={{ node1_ip }}
NODE2_IP={{ node2_ip }}
PXC_CLUSTER_NAME={{ pxc_cluster_name }}
PXC_CLUSTER_JOIN={{ pxc_cluster_join }}
PXC_SST_PASSWORD={{ pxc_sst_password }}

# Host ports. The crosswired-common stack is not expected to run at the same
# time, so standard ports are used.
TRAEFIK_HTTP_PORT={{ traefik_http_port }}
TRAEFIK_HTTPS_PORT={{ traefik_https_port }}
TRAEFIK_DASHBOARD_PORT={{ traefik_dashboard_port }}
MARIADB_PORT={{ mariadb_port }}

# MariaDB
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
KEYCLOAK_DB_NAME={{ keycloak_db_name }}
KEYCLOAK_DB_USER={{ keycloak_db_user }}
KEYCLOAK_DB_PASSWORD={{ keycloak_db_password }}

# PrivacyIDEA database (created by config/mariadb/initdb/01-init.sh)
PI_DB_NAME={{ pi_db_name }}
PI_DB_USER={{ pi_db_user }}
PI_DB_PASSWORD={{ pi_db_password }}

# Keycloak
KEYCLOAK_ADMIN={{ keycloak_admin }}
KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}

# PrivacyIDEA
PI_ADMIN_USER={{ pi_admin_user }}
PI_ADMIN_PASSWORD={{ pi_admin_password }}
PI_PEPPER={{ pi_pepper }}
PI_SECRET_KEY={{ pi_secret_key }}
PI_SKIP_BOOTSTRAP={{ pi_skip_bootstrap | lower }}
PI_SUPERUSER_REALM={{ pi_superuser_realm }}
